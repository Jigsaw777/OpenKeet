{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKeet",
  "mainBinaryName": "OpenKeet",
  "version": "0.1.1",
  "identifier": "dev.personalcopilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "OpenKeet","theme": "Dark", "width": 1150, "height": 790, "minWidth": 600, "minHeight": 530, "skipTaskbar": true, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Local interview practice workspace"
  }
}
