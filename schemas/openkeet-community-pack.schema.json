{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jigsaw777/Personal-Interview-Assistant/schemas/openkeet-community-pack.schema.json",
  "title": "OpenKeet community interview pack",
  "description": "Data-only interview question pack. The Rust validator in crates/copilot-core/src/prep/community.rs is authoritative; it also enforces referential integrity (skillIds, followupIds), plain-text safety (no HTML tags, script or data URLs) and the minimum app version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "version", "title", "description", "authors", "license", "language", "skills", "questions"],
  "properties": {
    "format": { "const": "openkeet.community-pack" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "authors": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "url": { "$ref": "#/$defs/url" } }
      }
    },
    "license": { "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"] },
    "language": { "type": "string", "pattern": "^[A-Za-z0-9-]{2,12}$" },
    "tags": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/slug" } },
    "minimumAppVersion": { "$ref": "#/$defs/semver" },
    "skills": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "behavioral": { "type": "boolean" }
        }
      }
    },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "skillIds", "question", "intent"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "skillIds": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/slug" } },
          "question": { "type": "string", "minLength": 5, "maxLength": 500 },
          "paraphrases": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 300 } },
          "intent": { "enum": ["explain", "compare", "design", "debug", "experience", "behavioral", "tradeoff", "other"] },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "answerOutline": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 200 } },
          "referenceAnswer": { "type": "string", "minLength": 10, "maxLength": 4000 },
          "followupIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/slug" } },
          "references": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["title"],
              "properties": { "title": { "type": "string", "minLength": 2, "maxLength": 200 }, "url": { "$ref": "#/$defs/url" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "url": { "type": "string", "maxLength": 300, "pattern": "^https://[^\\s\"'<>`]+$" }
  }
}
